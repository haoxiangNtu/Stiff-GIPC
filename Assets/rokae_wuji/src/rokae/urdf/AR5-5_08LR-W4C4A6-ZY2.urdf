  <!-- Shared mount link (top of the vertical column / crossbar). Each arm base is
       rotated -/+90deg about X so its joint_1 axis (originally vertical) lies
       horizontal along Y, and offset +/-2.5cm along Y (5cm between base origins)
       so the two arms extend outward back-to-back from the crossbar. -->
  <link name="world"/>
  <joint name="world2base_link" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  <link name="base_link"/>

  <link name="waist"/>
  <joint name="base_link2waist" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="waist"/>
  </joint>

  <link name="foot_l"/>
  <joint name="waist2foot_l" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="waist"/>
    <child link="foot_l"/>
  </joint>

  <link name="foot_r"/>
  <joint name="waist2foot_r" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="waist"/>
    <child link="foot_r"/>
  </joint>
