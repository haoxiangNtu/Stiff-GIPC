.vs*
build*
!tools/build_*.py
Output/*

# Internal-only handover and planning docs — never push to remote.
# See docs/internal/INDEX.md for what lives there.
docs/internal/

# Catch-all for stray maintainer-only Markdown at the repo root, in case a
# new handover/plan/research/findings doc gets created outside docs/internal/.
*_HANDOVER.md
*_FINDINGS.md
PLAN_*.md
RESEARCH_*.md

# Editor / IDE noise (.cursor/rules/ kept for parity with 87f90be baseline)
.cursor/
.cursor/rules/
.cache/
.polyscope.ini
imgui.ini

# Python build / runtime artefacts
__pycache__/
*.pyc
dist/
*.egg-info/
uv.lock

# stiff_physics installed-mode artefacts (built by scikit-build into the package)
stiff_physics/_native/
stiff_physics/data/

# Mesh-process scratch files (debug dumps from solvers)
*_skipped.face
*_skipped.node
__tracked_surface.stl
timeCost.txt

# Metis partitioner runtime cache (regenerated per scene per process count)
Assets/sorted_mesh/*.idx
Assets/sorted_mesh/*.msh
Assets/sorted_mesh/*.part

# Claude Code session state (per-worktree)
.claude/

# Per-user symlink directory (some demos hard-code `assets/...` paths;
# point this at your local stiff-physics asset root manually if you need
# them). Real engine assets live in capital-A `Assets/`.
/assets/

# Demo media — too large for git
*.mp4
