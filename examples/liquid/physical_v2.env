# Candidate "v2" liquid physics (2026-10-23, engine build with LIQ_BDF2 / LIQ_GP_REL; evidence: WATER_REALISM_REVIEW_2026-10-23.md).
# Source AFTER historical demo presets (it also applies physical_baseline.env: no sleep, no slow-motion drag, no table freezing).
#   dx 2.5 sloshing zeta 0.147 (lab preset) -> 0.072 with this GP6 (0.037 with LIQ_GP_FULL=3, which creeps 4-5x more at rest; real water ~0.008);
#   dam-break front 1.18 -> 1.62 sqrt(gH) (experiments 1.48-1.74);
#   still water (flask) 0.108 mm/s median, square tanks ~1.5 mm/s (the wall cut-cell residual; root fix = cut-cell volume operator, unfinished).
HERE_V2="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE_V2/physical_baseline.env"
export LIQ_BDF2=1          # second-order time integration of the grid nodes (implicit Euler damps a mode by w dt / 2: 0.06 for sloshing at 5 ms)
export LIQ_WFC=1           # wall field constraint (one-sided, slip)
export LIQ_WFC_GROUND=1
export LIQ_GP=1
export LIQ_GP_FULL=6       # ghost penalty: full gradient at rest, normal stretch when flowing ...
export LIQ_GP_REL=1        # ... with "at rest" measured relative to the wall (a carried vessel's water counts as resting)
export LIQ_PUSH_FILM=0     # the film push (with push-apart) slowed thin fronts: dam break 1.54 without, 1.18 with
export LIQ_FLOOR_GRAVITY=1 # mass floor 0.05 (add_liquid default) also weighed: lighter (0.01) or heavier (0.2) floors creep more
export LIQ_STI=0           # particle-pair surface tension: the largest damping source (sloshing 0.15 -> 0.53)
export LIQ_STM=0           # membrane surface tension: parasitic currents + long-run drop instability not solved yet
# keep at the call site: add_liquid(..., push_apart=0.9, j_mode=0, mass_floor=0.05); dt 5 ms (GP6's slow branch adds damping at smaller dt)
